{
  "status": "proposed; not MCP runtime discovery response; R6 must implement exact input and output JSON Schemas and tests",
  "version": "1.0-proposal",
  "transport": "Streamable HTTP /mcp",
  "tools": [
    {
      "name": "list_scenarios",
      "description": "List authorized scenario revisions and summaries",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "format": "uuid"
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "workspace_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "x-swarmforge-policy": "read",
      "x-output-contract": "Scenario summaries, cursor; no other workspace data"
    },
    {
      "name": "get_scenario",
      "description": "Read immutable scenario revision",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "format": "uuid"
          },
          "scenario_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "workspace_id",
          "scenario_id",
          "revision"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "x-swarmforge-policy": "read",
      "x-output-contract": "Canonical Revision including config hash"
    },
    {
      "name": "validate_scenario",
      "description": "Validate candidate scenario without saving",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "format": "uuid"
          },
          "scenario_config": {
            "type": "object",
            "description": "Canonical ScenarioConfig; enforce schema and semantic validator"
          }
        },
        "required": [
          "workspace_id",
          "scenario_config"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "x-swarmforge-policy": "read",
      "x-output-contract": "Canonical Validation, field issues"
    },
    {
      "name": "create_experiment_plan",
      "description": "Draft bounded immutable experiment plan; does not enqueue",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "format": "uuid"
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scenario_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "scenario_config": {
                  "type": "object",
                  "description": "Canonical ScenarioConfig from contracts/openapi.json; resolve and validate at R6"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "required": [
                "label"
              ],
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": [
                    "scenario_id",
                    "revision"
                  ],
                  "not": {
                    "required": [
                      "scenario_config"
                    ]
                  }
                },
                {
                  "required": [
                    "scenario_config"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "scenario_id"
                        ]
                      },
                      {
                        "required": [
                          "revision"
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            "minItems": 1,
            "maxItems": 4
          },
          "algorithms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "centralized_greedy",
                "local_auction",
                "scoped_lease"
              ]
            },
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true
          },
          "seeds": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "workspace_id",
          "objective",
          "cases",
          "algorithms",
          "seeds",
          "idempotency_key"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "x-swarmforge-policy": "draft",
      "x-output-contract": "plan_id, plan_hash, run_count<=12, engine_version, expires_at, status, trusted approval_url; validated canonical config/revisions"
    },
    {
      "name": "get_experiment_plan",
      "description": "Read draft/approval/execution status",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "format": "uuid"
