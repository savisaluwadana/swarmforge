        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "x-swarmforge-policy": "read",
      "x-output-contract": "plan ID, hash, approval state, run IDs, expiration, exact immutable input"
    },
    {
      "name": "execute_approved_plan",
      "description": "Enqueue exact approved plan once; never approves",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "format": "uuid"
          },
          "plan_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_plan_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "workspace_id",
          "plan_id",
          "expected_plan_hash",
          "idempotency_key"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "x-swarmforge-policy": "approved_write",
      "x-output-contract": "plan ID, persisted run/benchmark IDs, status; duplicate returns same IDs"
    },
