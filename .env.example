# Local development only; choose your own password, URL-encode reserved characters.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://swarmforge:replace-with-local-password@postgres:5432/swarmforge
ENGINE_VERSION=0.3.0

# Disabled by default; for loopback development set AUTH_MODE=local and generate a random token.
AUTH_MODE=disabled
LOCAL_DEMO_TOKEN=
LOCAL_DEMO_SUBJECT=demo
