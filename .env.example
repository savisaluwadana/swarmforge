# Local development only; choose your own password, URL-encode reserved characters.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://swarmforge:replace-with-local-password@postgres:5432/swarmforge
ENGINE_VERSION=0.3.0

# Disabled by default; for loopback development set AUTH_MODE=local and generate a random token.
AUTH_MODE=disabled
LOCAL_DEMO_TOKEN=
LOCAL_DEMO_SUBJECT=demo

# Separate human approval secret, never supplied to MCP clients. Optional HTTPS model provider disabled by default.
AGENT_APPROVAL_SECRET=
AGENT_LLM_URL=
AGENT_LLM_KEY=
AGENT_LLM_MODEL=
AGENT_LLM_MAX_CALL_USD=0
AGENT_LLM_WORKSPACE_DAY_USD=0
AGENT_LLM_INPUT_USD_PER_MILLION=0
AGENT_LLM_OUTPUT_USD_PER_MILLION=0

# Independently generated MCP-only credential; never reuse REST or approval credentials.
LOCAL_MCP_TOKEN=
